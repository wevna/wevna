{
  "name": "wevna",
  "version": "0.0.1",
  "private": true,
  "description": "Local-first runtime understanding tool for backend developers.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc --build && node ../../scripts/copy-dashboard-assets.mjs dist/dashboard",
    "dev": "tsup --watch",
    "check": "tsc --build",
    "test": "vitest run",
    "lint": "biome check ."
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@wevna/dashboard": "workspace:*",
    "@wevna/protocol": "workspace:*",
    "@wevna/server": "workspace:*",
    "express": "^5.2.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
