{
  "name": "@wevna/example-demo",
  "version": "0.0.1",
  "private": true,
  "description": "A Node service and a Python service calling each other, for recording a demo of Wevna.",
  "type": "module",
  "scripts": {
    "demo": "node scripts/start.mjs",
    "demo:down": "docker compose down",
    "traffic": "node scripts/traffic.mjs",
    "node-service": "tsx node-service/src/app.ts",
    "check": "tsc --noEmit && node scripts/check-python.mjs && node scripts/check-compose.mjs",
    "lint": "biome check . && node scripts/check-python.mjs --lint",
    "build": "tsc --noEmit && node scripts/check-python.mjs --compile"
  },
  "dependencies": {
    "@wevna/plugin-fetch": "workspace:*",
    "@wevna/sdk": "workspace:*",
    "express": "^5.2.1",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
